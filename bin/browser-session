#!/usr/bin/env bash
# Operator-only diagnostics helper. Agents use the structured browser_session_*
# MCP tools instead. An explicit token is required so this script never guesses a
# session from a process tree.
#
# 用法：
#   browser-session info                     # 打印自己的 DISPLAY/窗口/noVNC URL（JSON）
#   browser-session vnc                      # 只打印 noVNC 观看链接
#   browser-session writable [on|off]        # 切换 noVNC 只读/可写
#   browser-session screenshot <out.png>     # 截自己的主窗口
#   browser-session xdotool <args...>        # 在自己的窗口上跑 xdotool（自动 --window）
#   browser-session activate                 # 把自己的窗口置顶
set -euo pipefail
source "$(dirname "$0")/env.sh"

TOKEN="${ACS_SESSION_TOKEN:-}"
[ -z "$TOKEN" ] && { echo "ERROR: set ACS_SESSION_TOKEN for operator diagnostics; agents should use browser_session_* MCP tools" >&2; exit 2; }

manifest() { curl -fsS "http://127.0.0.1:${ACS_BROKER_PORT}/s/${TOKEN}/manifest"; }
field() { manifest | python3 -c "import sys,json;print(json.load(sys.stdin).get('$1') or '')"; }

cmd="${1:-info}"; shift || true
case "$cmd" in
  info)       manifest ;;
  token)      echo "$TOKEN" ;;
  vnc)        field novncUrl ;;
  writable)   on="${1:-on}"; q=$([ "$on" = off ] && echo 0 || echo 1)
              curl -fsS "http://127.0.0.1:${ACS_BROKER_PORT}/s/${TOKEN}/viewonly?on=$([ "$q" = 1 ] && echo 0 || echo 1)" ;;
  screenshot) out="${1:?用法: browser-session screenshot <out.png>}"
              win="$(field primaryWindowId)"; [ -z "$win" ] && { echo "no window yet" >&2; exit 1; }
              DISPLAY="$ACS_DISPLAY" import -window "$win" "$out" && echo "saved $out (window $win)" ;;
  xdotool)    win="$(field primaryWindowId)"; [ -z "$win" ] && { echo "no window yet" >&2; exit 1; }
              DISPLAY="$ACS_DISPLAY" xdotool "$@" --window "$win" ;;
  activate)   win="$(field primaryWindowId)"; [ -z "$win" ] && { echo "no window yet" >&2; exit 1; }
              DISPLAY="$ACS_DISPLAY" xdotool windowactivate "$win" 2>/dev/null || DISPLAY="$ACS_DISPLAY" xdotool windowraise "$win" ;;
  *)          echo "unknown: $cmd (info|vnc|writable|screenshot|xdotool|activate|token)" >&2; exit 2 ;;
esac
