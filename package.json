{
  "name": "@botmux-ai/plugin-agent-chrome",
  "version": "0.1.1",
  "description": "Agent Chrome Stack plugin for botmux.",
  "type": "commonjs",
  "keywords": [
    "botmux-plugin"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "validate": "node ./scripts/validate.mjs",
    "test": "npm run build && npm run validate && node ./test/check-launcher-runtime.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "chrome-devtools-mcp": "1.5.0",
    "esbuild": "^0.28.0",
    "puppeteer-core": "^25.2.1",
    "ws": "^8.18.0"
  },
  "botmux": {
    "schemaVersion": 1,
    "id": "agent-chrome",
    "displayName": "Agent Chrome",
    "service": {
      "mode": "auto"
    }
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT"
}
